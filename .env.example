# Copy this file to .env.local. Never commit .env.local.

# Local Supabase. `npx supabase start` prints the URL and anon key.
# The anon key below is the stock local demo key. If your CLI prints a different
# one, use that. Replace both values for a hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-only. The app does not need this for sign-up, farms, or the calendar.
# Do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Hosted Supabase: Project Settings → API.
# Use the project URL and the anon (publishable) key.
# Add http://127.0.0.1:43123 and your production URL to Authentication → URL configuration.
